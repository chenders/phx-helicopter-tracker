# ADS-B Exchange API Key (get from adsbexchange.com)
#ADSB_EXCHANGE_API_KEY=your_adsb_exchange_api_key_here

# Google Maps API Key (get from Google Cloud Console)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# FlightRadar24 credentials (optional, for premium features)
FR24_USERNAME=your_fr24_username_here
FR24_PASSWORD=your_fr24_password_here

# FlightRadar24 API Keys
FR24_API_KEY_SANDBOX=your_fr24_sandbox_key_here
FR24_API_KEY_PRODUCTION=your_fr24_production_key_here
FR24_API_ENVIRONMENT=sandbox
FR24_MONTHLY_CREDIT_LIMIT=500000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/phoenix_helicopters

# Redis
REDIS_URL=redis://localhost:6380

# Security
SECRET_KEY=change_this_to_a_secure_random_string

# Phoenix PD specific aircraft to track
PHOENIX_PD_AIRCRAFT=N621FB,N622FB,N623FB,N624FB,N625FB,N626FB,N627FB,N628FB

# Alert settings
ENABLE_REAL_TIME_ALERTS=false
ALERT_EMAIL=your_email@example.com

# Broadcastify credentials (optional, for radio transcription)
BROADCASTIFY_USERNAME=your_broadcastify_username_here
BROADCASTIFY_PASSWORD=your_broadcastify_password_here

# Application settings
APP_HOSTNAME=localhost