# EditorConfig — consistent formatting across editors. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Python — Black uses 4 spaces / 88-col
[*.py]
indent_size = 4
max_line_length = 88

# Frontend (TS/JS/JSON/CSS) — 2 spaces
[*.{ts,tsx,js,jsx,json,css,scss,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false  # trailing 2 spaces = hard line break in Markdown

[Makefile]
indent_style = tab
