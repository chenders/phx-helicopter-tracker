# Redis connection settings
# Replace with your Ubuntu server's IP address
REDIS_HOST=192.168.1.100
REDIS_PORT=6380
REDIS_DB=0

# Audio data paths (macOS paths)
AUDIO_INPUT_PATH=/Users/Shared/transcription/input
TRANSCRIPTION_OUTPUT_PATH=/Users/Shared/transcription/output

# Whisper model cache directory (will use macOS cache directory)
MODEL_CACHE_DIR=~/Library/Caches/whisper

# Worker settings
WORKER_NAME=m1-transcriber-01
WORKER_CONCURRENCY=1  # Process one file at a time for GPU memory management

# Apple Silicon GPU settings
USE_MPS=true  # Use Metal Performance Shaders for GPU acceleration
MPS_FALLBACK_CPU=true  # Fallback to CPU if MPS fails

# Optional: Whisper model to use by default
# Options: tiny, base, small, medium, large, large-v2, large-v3
# Recommended for M1: base or small (good balance of speed and accuracy)
DEFAULT_WHISPER_MODEL=base

# Performance tuning for M1
MAX_BATCH_SIZE=5  # M1 has 8GB/16GB unified memory, adjust based on your model
MEMORY_EFFICIENT=true  # Use memory-efficient attention mechanism