# ADS-B Exchange API Key (get from rapidapi.com - subscribe to ADSBexchange.com API)
ADSB_EXCHANGE_API_KEY=your_rapidapi_key_here

# Google Maps API Key (get from Google Cloud Console)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# FlightRadar24 credentials (optional, for premium features)
FR24_USERNAME=your_fr24_username
FR24_PASSWORD=your_fr24_password

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/phoenix_helicopters

# Redis
REDIS_URL=redis://localhost:6380

# Security
SECRET_KEY=change_this_in_production

# Phoenix PD specific aircraft to track
PHOENIX_PD_AIRCRAFT=N624FB,N625FB,N626FB,N627FB,N628FB

# Alert settings
ENABLE_REAL_TIME_ALERTS=true
ALERT_EMAIL=your_email@example.com